{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "giao-vien-ai-toan-nang3.vercel.app"
        }
      ],
      "destination": "https://www.dekiemtraso.com/:path*",
      "permanent": true
    },
    {
      "source": "/eng12_vocab",
      "destination": "/eng12_vocab/",
      "permanent": true
    },
    {
      "source": "/tienganh12",
      "destination": "/eng12_vocab/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|eng12_vocab/|.*\\..*).*)$",
      "destination": "/index.html"
    }
  ]
}